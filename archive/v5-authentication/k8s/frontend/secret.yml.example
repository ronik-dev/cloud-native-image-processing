# The value here MUST be byte-for-byte identical to the "secret" field for the gateway client in keycloak-realm-configmap.yml.
# There is no automatic sync between the two, since one lives in a Secret and the other in a realm-import ConfigMap. 
# IF YOU ROTATE ONE, ROTATE BOTH.

apiVersion: v1
kind: Secret
metadata:
  name: gateway-oauth2-secret
  namespace: imageprocessing
type: Opaque
stringData:
  KEYCLOAK_CLIENT_SECRET: gateway-client-secret-CHANGE-ME
