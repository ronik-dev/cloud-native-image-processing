apiVersion: v1
kind: Secret
metadata:
  name: keycloak-db-secret
  namespace: imageprocessing
type: Opaque
stringData:
  KC_DB_USERNAME: keycloak_user_example
  KC_DB_PASSWORD: keycloak_pw_example
---
apiVersion: v1
kind: Secret
metadata:
  name: keycloak-admin-secret
  namespace: imageprocessing
type: Opaque
stringData:
  # KC_BOOTSTRAP_ADMIN_* only takes effect the very first time Keycloak
  # initializes an empty master realm (Keycloak 26+ replacement for the
  # deprecated KEYCLOAK_ADMIN/KEYCLOAK_ADMIN_PASSWORD vars). Once the
  # persistent Postgres-backed master realm exists, changing these values
  # and redeploying does NOT reset the admin account -- create additional
  # admins via the Admin Console afterward if needed.
  KC_BOOTSTRAP_ADMIN_USERNAME: admin_example
  KC_BOOTSTRAP_ADMIN_PASSWORD: admin_pw_example
